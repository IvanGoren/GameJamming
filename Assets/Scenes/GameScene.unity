  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameManager
  gameOverCanvas: {fileID: 2134950863}
  musicController: {fileID: 2094537206}
  dialogueCanvas: {fileID: 0}
  dialogueAudioMgr: {fileID: 566676922}
  timedEvents:
  - eventName: 00:07 - Ev1-Fuzz
    triggerAtSeconds: 7
    speaker: 1
    dialogueText: 
    dialogueAudio: {fileID: 8300000, guid: 03127e4b6e53b9d459e4dcb3cd6a2129, type: 3}
    dialogueDurationSeconds: 2
    objectsToShow:
    - {fileID: 0}
    hideObjectsOnStart: 1
    hideAfterSeconds: 2
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 00:09 - Ev2-D1-DrP - Columna
    triggerAtSeconds: 9
    speaker: 1
    dialogueText: "\xBFSe me escucha? Aj\xE9m, PATO JR. veo que pudiste superar mi
      prueba, pero no te sientas tan confiado\u2026 Muajajaja."
    dialogueAudio: {fileID: 8300000, guid: 44a1a7b65f7f81244ad7dbb8a9012ead, type: 3}
    dialogueDurationSeconds: 4
    objectsToShow: []
    hideObjectsOnStart: 0
    hideAfterSeconds: 0
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 00:25 - Ev3-D2-DrP - Horda
    triggerAtSeconds: 25
    speaker: 1
    dialogueText: "\xA1Ja! Pensas que podes conmigo, pero ahora vienen los patos
      m\xE1s poderosos de toda la historia."
    dialogueAudio: {fileID: 8300000, guid: 44a1a7b65f7f81244ad7dbb8a9012ead, type: 3}
    dialogueDurationSeconds: 3
    objectsToShow: []
    hideObjectsOnStart: 0
    hideAfterSeconds: 0
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 00:28 - Ev4-D2-DrP2 - Horda
    triggerAtSeconds: 28
    speaker: 1
    dialogueText: "\xA1Veamos si pod\xE9s contra mi EJ\xC9RCITO DE PATOS ZOMBIE!"
    dialogueAudio: {fileID: 8300000, guid: 44a1a7b65f7f81244ad7dbb8a9012ead, type: 3}
    dialogueDurationSeconds: 3
    objectsToShow: []
    hideObjectsOnStart: 0
    hideAfterSeconds: 0
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 00:31 - Ev5-D2-DrP3 - Horda
    triggerAtSeconds: 31
    speaker: 1
    dialogueText: 
    dialogueAudio: {fileID: 8300000, guid: 28789f39b27549a40994907811eaa5eb, type: 3}
    dialogueDurationSeconds: 5
    objectsToShow: []
    hideObjectsOnStart: 0
    hideAfterSeconds: 0
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 00:40 - Ev5.2-D2-DrP - Horda
    triggerAtSeconds: 40
    speaker: 1
    dialogueText: El Pasante se volvio a olvidar de pagar los sueldos?
    dialogueAudio: {fileID: 8300000, guid: 44a1a7b65f7f81244ad7dbb8a9012ead, type: 3}
    dialogueDurationSeconds: 3
    objectsToShow: []
    hideObjectsOnStart: 0
    hideAfterSeconds: 0
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 00:45 - Ev6-D3-Glitch
    triggerAtSeconds: 45
    speaker: 1
    dialogueText: 
    dialogueAudio: {fileID: 0}
    dialogueDurationSeconds: 0
    objectsToShow: []
    hideObjectsOnStart: 0
    hideAfterSeconds: 0
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 00:52 - Ev7-D3-DrP - Glitch
    triggerAtSeconds: 52
    speaker: 1
    dialogueText: "\xBFSe desconfiguraron mis esbirros? Los Devs ya no quieren laburar\u2026"
    dialogueAudio: {fileID: 8300000, guid: 44a1a7b65f7f81244ad7dbb8a9012ead, type: 3}
    dialogueDurationSeconds: 3
    objectsToShow: []
    hideObjectsOnStart: 0
    hideAfterSeconds: 0
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 00:60 - Ev8-D4-DrP - MegaPato
    triggerAtSeconds: 60
    speaker: 1
    dialogueText: "No importa, esos patos no sirven, pero seguro que no pod\xE9s
      contra \xE9l. \xA1MI S\xDAPER MEGA PATO ZOMBIE!"
    dialogueAudio: {fileID: 8300000, guid: 44a1a7b65f7f81244ad7dbb8a9012ead, type: 3}
    dialogueDurationSeconds: 5
    objectsToShow: []
    hideObjectsOnStart: 0
    hideAfterSeconds: 0
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 01:03 - Ev9-D4 - MegaPato
    triggerAtSeconds: 63
    speaker: 1
    dialogueText: 
    dialogueAudio: {fileID: 8300000, guid: 52466db6ef9368546a8deb9f76af354a, type: 3}
    dialogueDurationSeconds: 6
    objectsToShow: []
    hideObjectsOnStart: 0
    hideAfterSeconds: 0
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 01:10 - Ev10-D4-Pjr - MegaPato
    triggerAtSeconds: 70
    speaker: 0
    dialogueText: "Che, \xBFes una cargada esto?"
    dialogueAudio: {fileID: 8300000, guid: 4902240d2ea87074585d9b291ecec97a, type: 3}
    dialogueDurationSeconds: 3
    objectsToShow: []
    hideObjectsOnStart: 0
    hideAfterSeconds: 0
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 01:15 - Ev11-D4-DrP - MegaPato
    triggerAtSeconds: 75
    speaker: 1
    dialogueText: "\xA1Estos idiotas! Ya van a venir a pedir un aumento. Malditos
      programadores de tercera."
    dialogueAudio: {fileID: 8300000, guid: 44a1a7b65f7f81244ad7dbb8a9012ead, type: 3}
    dialogueDurationSeconds: 6
    objectsToShow: []
    hideObjectsOnStart: 0
    hideAfterSeconds: 0
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 01:19 - Ev12-D5-DrP - Arma
    triggerAtSeconds: 79
    speaker: 1
    dialogueText: "No importa, con mi arma sonora vas a quedar completamente incapacitado.
      \xA1Suenen la alarma!"
    dialogueAudio: {fileID: 8300000, guid: 44a1a7b65f7f81244ad7dbb8a9012ead, type: 3}
    dialogueDurationSeconds: 3
    objectsToShow: []
    hideObjectsOnStart: 0
    hideAfterSeconds: 0
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 01:22 - Ev13-D5-Alarm - Arma
    triggerAtSeconds: 82
    speaker: 1
    dialogueText: 
    dialogueAudio: {fileID: 8300000, guid: d31882d38ba0ff347ae967d9156aba13, type: 3}
