    dialogueAudio: {fileID: 0}
    dialogueDurationSeconds: 6
    objectsToShow: []
    hideObjectsOnStart: 0
    hideAfterSeconds: 0
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 01:30 - Ev15-D5-DrP - Arma
    triggerAtSeconds: 90
    speaker: 0
    dialogueText: "\xBFEso es todo?"
    dialogueAudio: {fileID: 8300000, guid: 4902240d2ea87074585d9b291ecec97a, type: 3}
    dialogueDurationSeconds: 3
    objectsToShow: []
    hideObjectsOnStart: 0
    hideAfterSeconds: 0
    onTrigger:
      m_PersistentCalls:
        m_Calls: []
    hasTriggered: 0
  - eventName: 01:35 - Ev16-D5-DrP - Arma
    triggerAtSeconds: 95
    speaker: 1
    dialogueText: "PASANTE DECEREBRADO, INCAPAZ, BURRO DE LA VIDA.\r\n\xA1TE VOY
      A DEJAR DE PATITAS EN LA CALLE!\r\n"
    dialogueAudio: {fileID: 8300000, guid: 44a1a7b65f7f81244ad7dbb8a9012ead, type: 3}
